# Google Apps Script web app connected to the RSVP spreadsheet.
# These variables are server-only and must also be added to Vercel.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET="replace-with-the-same-secret-used-in-Code.gs"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
